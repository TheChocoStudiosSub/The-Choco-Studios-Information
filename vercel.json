{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/choco-ai.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/choco-ai-help-center.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/kasirkita.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/chocoscan.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/chocobot-guardian.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/privacy-guardian.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-admin-dashboard-ui-kit.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-business-document-kit.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-business-management-system.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-business-presentation-kit.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-complete-umkm-suite.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-finance-cashflow-pro.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-professional-cv-kit.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-social-media-business-kit.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-umkm-stock-sales-tracker.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/tcs-umkm-website-kit.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "the-choco-studios-information.vercel.app"
        }
      ],
      "destination": "https://information.thechocostudios.bond/:path*",
      "permanent": true
    }
  ]
}
